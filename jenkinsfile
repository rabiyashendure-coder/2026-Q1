pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'Q2', 
                url: 'https://github.com/your-username/2026-Q1.git'
            }
        }

        stage('Build Q2') {
            steps {
                echo "Building QA branch"
                sh 'ls -l'
            }
        }

        stage('Archive File') {
            steps {
                archiveArtifacts artifacts: 'index.html', fingerprint: true
            }
        }
    }
}
